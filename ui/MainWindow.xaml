<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hermes Easy Setup" Height="860" Width="980" MinHeight="720" MinWidth="820"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
        Foreground="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" FontFamily="Segoe UI" FontSize="14">
  <Grid Margin="28">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0">
      <TextBlock Text="Hermes Easy Setup" FontSize="30" FontWeight="SemiBold"
                 AutomationProperties.Name="Hermes Easy Setup 제목"/>
      <TextBlock Margin="0,6,0,0" Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                 Text="NousResearch Hermes Agent를 한국어로 점검하고, 검증된 공식 설치기로 안전하게 설치합니다."/>
    </StackPanel>

    <Border Grid.Row="1" Margin="0,20,0,20" Padding="14,10" CornerRadius="5"
            BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}" BorderThickness="1">
      <TextBlock x:Name="StepText" Text="1 / 5  PC 확인" FontWeight="SemiBold"
                 AutomationProperties.Name="현재 설치 단계" AutomationProperties.LiveSetting="Polite"/>
    </Border>

    <Grid Grid.Row="2">
      <Grid x:Name="WelcomePanel">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel>
          <TextBlock Text="먼저 이 PC가 설치 준비가 되었는지 확인합니다." FontSize="20" FontWeight="SemiBold"/>
          <TextBlock Margin="0,10,0,0" TextWrapping="Wrap"
                     Text="이 단계에서는 시스템을 변경하지 않습니다. Windows 버전, CPU 아키텍처, PowerShell, 경로와 여유 공간만 읽습니다."/>
          <Button x:Name="DiagnoseButton" Margin="0,20,0,0" Width="180" Height="42" HorizontalAlignment="Left"
                  Content="PC 확인 시작" IsDefault="True" AutomationProperties.Name="PC 확인 시작"/>
        </StackPanel>
        <TextBox x:Name="DiagnosisText" Grid.Row="1" Margin="0,18,0,0" Padding="12" IsReadOnly="True"
                 TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
                 AutomationProperties.Name="PC 확인 결과"/>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
          <ComboBox x:Name="ExistingSetupModeCombo" Width="155" Height="38" Margin="0,0,10,0"
                    SelectedIndex="0" Visibility="Collapsed" IsEnabled="False"
                    AutomationProperties.Name="기존 Hermes 설치 설정 방식">
            <ComboBoxItem Tag="Portal" Content="Nous Portal"/>
            <ComboBoxItem Tag="Full" Content="전체 설정"/>
          </ComboBox>
          <Button x:Name="ExistingSetupButton" Width="180" Height="38" Margin="0,0,10,0"
                  Content="기존 설치 설정 계속" Visibility="Collapsed" IsEnabled="False"
                  AutomationProperties.Name="기존 Hermes 설치 공식 설정 계속"/>
          <Button x:Name="WelcomeCloseButton" Width="110" Height="38" Margin="0,0,10,0" Content="닫기" IsCancel="True"/>
          <Button x:Name="ToPlanButton" Width="150" Height="38" Content="설치 계획 보기" IsEnabled="False"/>
        </StackPanel>
      </Grid>

      <Grid x:Name="PlanPanel" Visibility="Collapsed">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="설치 옵션과 변경 계획을 검토하세요." FontSize="20" FontWeight="SemiBold"/>
        <Grid Grid.Row="1" Margin="0,16,0,0">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0" Margin="0,0,20,0">
            <CheckBox x:Name="IncludeDesktopCheck" IsEnabled="False" Content="Hermes Desktop 자동 빌드 (후속 버전 예정)"/>
            <CheckBox x:Name="SkipComputerUseCheck" Margin="0,12,0,0" IsChecked="True" IsEnabled="False"
                      Content="Computer Use 사전 설치 건너뛰기 (v0.1.2 보안 정책)"/>
          </StackPanel>
          <StackPanel Grid.Column="1">
            <TextBlock Text="설치 후 공급자 설정"/>
            <ComboBox x:Name="SetupModeCombo" Margin="0,6,0,0" SelectedIndex="0" AutomationProperties.Name="설치 후 공급자 설정 방식">
              <ComboBoxItem Tag="Portal" Content="Nous Portal — 브라우저 로그인 및 모델 선택 (권장)"/>
              <ComboBoxItem Tag="Full" Content="전체 설정 — 공식 터미널 마법사"/>
              <ComboBoxItem Tag="Later" Content="나중에 설정"/>
            </ComboBox>
          </StackPanel>
        </Grid>
        <TextBox x:Name="PlanText" Grid.Row="2" Margin="0,18,0,0" Padding="12" IsReadOnly="True"
                 TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
                 AutomationProperties.Name="설치 변경 계획"/>
        <StackPanel Grid.Row="3" Margin="0,16,0,0">
          <CheckBox x:Name="ApprovalCheck" FontWeight="SemiBold">
            <TextBlock TextWrapping="Wrap"
                       Text="위 계획에 따라 공식 설치기를 실행하고 내 PC에 파일·환경 변수를 변경하는 데 동의합니다."/>
          </CheckBox>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="BackButton" Width="110" Height="38" Margin="0,0,10,0" Content="뒤로"/>
            <Button x:Name="InstallButton" Width="170" Height="38" Content="설치 시작" IsEnabled="False"/>
          </StackPanel>
        </StackPanel>
      </Grid>

      <Grid x:Name="WorkPanel" Visibility="Collapsed">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel>
          <TextBlock x:Name="WorkTitle" Text="Hermes를 설치하고 있습니다." FontSize="20" FontWeight="SemiBold"/>
          <TextBlock x:Name="WorkStatus" Margin="0,8,0,0" Text="공식 설치기 준비 중..." TextWrapping="Wrap"
                     AutomationProperties.LiveSetting="Polite"/>
        </StackPanel>
        <ProgressBar x:Name="InstallProgress" Grid.Row="1" Margin="0,18,0,0" Height="22" Minimum="0" Maximum="100"
                     AutomationProperties.Name="Hermes 설치 진행률"/>
        <TextBox x:Name="WorkLog" Grid.Row="2" Margin="0,18,0,0" Padding="10" IsReadOnly="True"
                 AcceptsReturn="True" TextWrapping="NoWrap" FontFamily="Consolas" FontSize="12"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                 AutomationProperties.Name="설치 진행 로그"/>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
          <Button x:Name="BundleButton" Width="160" Height="38" Margin="0,0,10,0" Content="진단 ZIP 만들기" Visibility="Collapsed"/>
          <Button x:Name="FinishButton" Width="140" Height="38" Content="마법사 닫기" IsEnabled="False"/>
        </StackPanel>
      </Grid>

      <Grid x:Name="SetupPanel" Visibility="Collapsed">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel>
          <TextBlock x:Name="SetupTitle" Text="Hermes 설치가 완료되었습니다." FontSize="20" FontWeight="SemiBold"/>
          <TextBlock x:Name="SetupStatus" Margin="0,8,0,0" Text="공식 설정을 시작할 준비가 되었습니다." TextWrapping="Wrap"
                     AutomationProperties.Name="Hermes 공식 설정 상태" AutomationProperties.LiveSetting="Polite"/>
        </StackPanel>
        <Border Grid.Row="1" Margin="0,18,0,0" Padding="16" CornerRadius="5"
                BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}" BorderThickness="1"
                Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}">
          <TextBlock x:Name="SetupDetails" TextWrapping="Wrap"
                     Text="설정 시작을 누르면 별도의 공식 Hermes 콘솔이 열립니다. 로그인과 API 키 입력은 그 창에서만 진행됩니다."
                     AutomationProperties.Name="Hermes 공식 설정 안내"/>
        </Border>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
          <Button x:Name="SetupLaterButton" Width="140" Height="38" Margin="0,0,10,0"
                  Content="나중에 설정" IsEnabled="False"/>
          <Button x:Name="SetupStartButton" Width="190" Height="38" Margin="0,0,10,0"
                  Content="공식 설정 시작" IsEnabled="False" IsDefault="True"
                  AutomationProperties.Name="Hermes 공식 설정 시작"/>
          <Button x:Name="SetupLabButton" Width="160" Height="38" Margin="0,0,10,0"
                  Content="연구실 연결 계속" IsEnabled="False"
                  AutomationProperties.Name="연구실 Mattermost 연결 계속"/>
          <Button x:Name="SetupFinishButton" Width="140" Height="38"
                  Content="마법사 닫기" IsEnabled="False"/>
        </StackPanel>
      </Grid>

      <Grid x:Name="LabPanel" Visibility="Collapsed">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel>
          <TextBlock Text="연구실 Mattermost에 새 Hermes 에이전트를 연결합니다." FontSize="20" FontWeight="SemiBold"/>
          <TextBlock Margin="0,8,0,0" TextWrapping="Wrap"
                     Text="provider/model 설정을 복제한 새 프로필을 만들고, Mattermost·NetBird Dashboard·자동 시작 Gateway·Bot Control 등록을 한 번에 구성합니다."/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" Margin="0,16,0,0" VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="0,0,8,0">
            <Border Padding="14" CornerRadius="5" BorderThickness="1"
                    BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}">
              <StackPanel>
                <TextBlock Text="에이전트 프로필" FontWeight="SemiBold" FontSize="16"/>
                <Grid Margin="0,12,0,0">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                  <StackPanel Grid.Column="0">
                    <TextBlock Text="Profile name"/>
                    <TextBox x:Name="LabProfileName" Margin="0,5,0,0" Height="32" Text="lab-agent"/>
                  </StackPanel>
                  <StackPanel Grid.Column="2">
                    <TextBlock Text="Full name"/>
                    <TextBox x:Name="LabFullName" Margin="0,5,0,0" Height="32"/>
                  </StackPanel>
                  <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Margin="0,12,0,0">
                    <TextBlock Text="Role / responsibilities"/>
                    <TextBox x:Name="LabRole" Margin="0,5,0,0" Height="68" AcceptsReturn="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"/>
                  </StackPanel>
                  <CheckBox x:Name="LabReuseProfile" Grid.Row="2" Grid.ColumnSpan="3" Margin="0,10,0,0"
                            Content="같은 이름의 기존 프로필이 있으면 이어서 설정"/>
                </Grid>
              </StackPanel>
            </Border>

            <Border Margin="0,12,0,0" Padding="14" CornerRadius="5" BorderThickness="1"
                    BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}">
              <StackPanel>
                <TextBlock Text="Mattermost 연결" FontWeight="SemiBold" FontSize="16"/>
                <Grid Margin="0,12,0,0">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                  <StackPanel Grid.Column="0">
                    <TextBlock Text="Server URL"/>
                    <TextBox x:Name="LabMattermostURL" Margin="0,5,0,0" Height="32" Text="http://100.69.181.62:8065"/>
                  </StackPanel>
                  <StackPanel Grid.Column="2">
                    <TextBlock Text="Bot token"/>
                    <PasswordBox x:Name="LabBotToken" Margin="0,5,0,0" Height="32"/>
                  </StackPanel>
                  <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,12,0,0">
                    <TextBlock Text="Allowed user IDs (comma-separated)"/>
                    <TextBox x:Name="LabAllowedUserIDs" Margin="0,5,0,0" Height="32"/>
                  </StackPanel>
                  <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,12,0,0">
                    <TextBlock Text="Home channel ID"/>
                    <TextBox x:Name="LabHomeChannelID" Margin="0,5,0,0" Height="32"/>
                  </StackPanel>
                  <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,12,0,0">
                    <TextBlock Text="응답 조건"/>
                    <CheckBox x:Name="LabRequireMention" Margin="0,9,0,0" IsChecked="True" Content="멘션된 경우만 응답"/>
                  </StackPanel>
                  <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,12,0,0">
                    <TextBlock Text="답변 위치"/>
                    <ComboBox x:Name="LabReplyMode" Margin="0,5,0,0" Height="32" SelectedIndex="0">
                      <ComboBoxItem Tag="off" Content="대화 위치 유지"/>
                      <ComboBoxItem Tag="thread" Content="항상 스레드"/>
                    </ComboBox>
                  </StackPanel>
                </Grid>
              </StackPanel>
            </Border>

            <Border Margin="0,12,0,0" Padding="14" CornerRadius="5" BorderThickness="1"
                    BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}">
              <StackPanel>
                <TextBlock Text="Hermes Dashboard와 자동 시작" FontWeight="SemiBold" FontSize="16"/>
                <TextBlock Margin="0,5,0,0" FontSize="12" TextWrapping="Wrap"
                           Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                           Text="Dashboard는 NetBird IP에 바인딩하고 로그인 시 숨김 Scheduled Task로 시작합니다. Bot Control이 이 연결을 자동 등록해 이후 설정 적용에 사용합니다."/>
                <Grid Margin="0,12,0,0">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="1.3*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="0.5*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="0.8*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <StackPanel Grid.Column="0">
                    <TextBlock Text="NetBird IPv4"/>
                    <DockPanel Margin="0,5,0,0">
                      <Button x:Name="LabDetectNetBirdButton" DockPanel.Dock="Right" Margin="6,0,0,0" Width="62" Height="32" Content="감지"/>
                      <TextBox x:Name="LabNetBirdIP" Height="32"/>
                    </DockPanel>
                  </StackPanel>
                  <StackPanel Grid.Column="2">
                    <TextBlock Text="Port"/>
                    <TextBox x:Name="LabDashboardPort" Margin="0,5,0,0" Height="32" Text="9119"/>
                  </StackPanel>
                  <StackPanel Grid.Column="4">
                    <TextBlock Text="Username"/>
                    <TextBox x:Name="LabDashboardUsername" Margin="0,5,0,0" Height="32" Text="admin"/>
                  </StackPanel>
                  <StackPanel Grid.Column="6">
                    <TextBlock Text="Password"/>
                    <PasswordBox x:Name="LabDashboardPassword" Margin="0,5,0,0" Height="32"/>
                  </StackPanel>
                </Grid>
              </StackPanel>
            </Border>

            <ProgressBar x:Name="LabProgress" Margin="0,14,0,0" Height="18" Minimum="0" Maximum="100"/>
            <TextBox x:Name="LabStatus" Margin="0,10,0,0" Height="90" Padding="9" IsReadOnly="True"
                     TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                     Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
                     Text="필수 값을 입력한 뒤 연결 시작을 누르세요."/>
          </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
          <Button x:Name="LabBackButton" Width="110" Height="38" Margin="0,0,10,0" Content="뒤로"/>
          <Button x:Name="LabCloseButton" Width="110" Height="38" Margin="0,0,10,0" Content="닫기"/>
          <Button x:Name="LabApplyButton" Width="190" Height="38" Content="연구실 연결 시작" IsDefault="True"/>
        </StackPanel>
      </Grid>
    </Grid>

    <TextBlock Grid.Row="3" Margin="0,18,0,0" FontSize="12"
               Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" TextWrapping="Wrap"
               Text="비공식·미서명 커뮤니티 도구입니다. Nous Research 공식 제품이 아니며, API 키를 수집하거나 자동 업로드하지 않습니다."/>
  </Grid>
</Window>
