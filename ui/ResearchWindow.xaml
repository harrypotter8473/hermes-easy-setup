<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hermes Research Setup — 1인 연구실" Width="1060" Height="850" MinWidth="960" MinHeight="740"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI, Malgun Gothic" FontSize="14" Background="#F5F7FB">
  <Window.Resources>
    <Style TargetType="Button"><Setter Property="Padding" Value="14,8"/><Setter Property="Margin" Value="0,0,8,0"/></Style>
    <Style TargetType="TextBox"><Setter Property="Padding" Value="8,5"/></Style>
    <Style TargetType="PasswordBox"><Setter Property="Padding" Value="8,5"/></Style>
  </Window.Resources>
  <Grid Margin="24">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,16">
      <TextBlock Text="내 PC에 만드는 1인 연구실" FontSize="28" FontWeight="SemiBold" Foreground="#172A4A"/>
      <TextBlock Text="Mattermost 로컬 서버 + Hermes + 독립 연구 에이전트 4개" Margin="0,6,0,0" Foreground="#56657D"/>
    </StackPanel>
    <TabControl x:Name="WizardTabs" Grid.Row="1">
      <TabItem x:Name="ServerTab" Header="1. 로컬 서버">
        <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="20">
          <TextBlock Text="이 PC에서 Mattermost 서버와 관리자 계정을 만듭니다." FontSize="20" FontWeight="SemiBold"/>
          <TextBlock Text="Docker Desktop의 Linux 엔진이 필요합니다. 기본 주소는 http://127.0.0.1:18065 입니다." TextWrapping="Wrap" Margin="0,10,0,16"/>
          <WrapPanel><Button x:Name="DockerCheckButton" Content="Docker 준비 다시 확인"/><Button x:Name="DockerOpenButton" Content="Docker Desktop 열기" IsEnabled="False"/><Button x:Name="ServerRestoreButton" Content="기존 연구 서버 불러오기"/></WrapPanel>
          <TextBlock x:Name="DockerStatus" Text="설치 위치·공식 서명·Linux 엔진과 PC 준비 상태를 확인합니다." Margin="0,12,0,8" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
          <TextBlock x:Name="DockerPrerequisites" TextWrapping="Wrap" Foreground="#56657D" Margin="0,0,0,10"/>
          <Border Background="#EDF2FB" Padding="12" CornerRadius="4" Margin="0,0,0,10"><StackPanel>
            <CheckBox x:Name="DockerInstallConsent" IsEnabled="False"><TextBlock Text="미설치 시 공식 Docker Desktop을 다운로드·검증하고 사용자별 설치를 시작하는 데 동의합니다. 약관은 Docker에서 직접 확인하며, Windows 기능 설정·재부팅은 별도 안내에 따릅니다." TextWrapping="Wrap"/></CheckBox>
            <WrapPanel Margin="0,10,0,0"><Button x:Name="DockerInstallButton" Content="공식 Docker 다운로드·설치" IsEnabled="False"/><Button x:Name="DockerGuideButton" Content="공식 설치·약관 안내"/></WrapPanel>
          </StackPanel></Border>
          <Expander Header="Docker를 사용할 수 없다면?" Margin="0,0,0,16"><TextBlock x:Name="DockerAlternatives" Text="WSL2가 가능하면 Ubuntu 내부 직접 설치를 별도 개발할 수 있습니다. 가상화도 불가하면 별도 Linux 서버 또는 기존 Mattermost 서버 연결이 대안입니다. 이 초기 버전에서는 대안 안내만 제공하며 조직 정책을 우회하지 않습니다." TextWrapping="Wrap" Margin="0,8,0,0"/></Expander>
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <StackPanel Margin="0,0,0,14"><TextBlock Text="서버 ID"/><TextBox x:Name="ServerId" Text="research-local" Margin="0,5,0,0"/></StackPanel>
            <StackPanel Grid.Column="2"><TextBlock Text="로컬 포트"/><TextBox x:Name="ServerPort" Text="18065" Margin="0,5,0,0"/></StackPanel>
            <StackPanel Grid.Row="1" Margin="0,0,0,14"><TextBlock Text="관리자 사용자 이름"/><TextBox x:Name="AdminUsername" Text="researcher" Margin="0,5,0,0"/></StackPanel>
            <StackPanel Grid.Row="1" Grid.Column="2"><TextBlock Text="관리자 이메일"/><TextBox x:Name="AdminEmail" Margin="0,5,0,0"/></StackPanel>
            <StackPanel Grid.Row="2"><TextBlock Text="관리자 비밀번호 (12자 이상·대소문자·숫자·특수문자)"/><PasswordBox x:Name="AdminPassword" Margin="0,5,0,0"/></StackPanel>
            <StackPanel Grid.Row="2" Grid.Column="2"><TextBlock Text="비밀번호 확인"/><PasswordBox x:Name="PasswordConfirm" Margin="0,5,0,0"/></StackPanel>
          </Grid>
          <CheckBox x:Name="ServerResumeCheck" Content="이 마법사에서 만든 같은 서버를 이어서 설정" Margin="0,16,0,10"/>
          <CheckBox x:Name="ServerConsent" Content="이 PC에 Mattermost·PostgreSQL 서버와 연구용 팀·채널을 생성하는 데 동의합니다." Margin="0,0,0,16"/>
          <WrapPanel><Button x:Name="ServerCreateButton" Content="로컬 서버 설치" IsEnabled="False"/><Button x:Name="ServerOpenButton" Content="내 연구실 열기" IsEnabled="False"/><Button x:Name="ServerNextButton" Content="다음: Hermes" IsEnabled="False"/></WrapPanel>
          <TextBlock x:Name="ServerStatus" TextWrapping="Wrap" Margin="0,16,0,0" AutomationProperties.LiveSetting="Polite"/>
        </StackPanel></ScrollViewer>
      </TabItem>
      <TabItem x:Name="HermesTab" Header="2. Hermes·모델" IsEnabled="False">
        <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="20">
          <TextBlock Text="Hermes를 설치하고 네 에이전트가 사용할 모델을 연결합니다." FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"/>
          <WrapPanel Margin="0,16,0,12"><Button x:Name="HermesPlanButton" Content="PC 확인·설치 계획"/><Button x:Name="HermesStatusButton" Content="기존 Hermes·인증 확인"/></WrapPanel>
          <TextBox x:Name="HermesPlanText" Height="130" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Hermes 설치 계획"/>
          <CheckBox x:Name="HermesConsent" Content="표시된 계획에 따라 검증된 공식 Hermes 설치기를 실행하는 데 동의합니다." Margin="0,12,0,12"/>
          <Button x:Name="HermesInstallButton" Content="Hermes 설치" HorizontalAlignment="Left" IsEnabled="False"/>
          <Separator Margin="0,16,0,16"/>
          <WrapPanel><Button x:Name="AuthButton" Content="모델 계정 로그인" IsEnabled="False"/><Button x:Name="AuthOpenButton" Content="인증 페이지 열기" IsEnabled="False"/></WrapPanel>
          <TextBlock x:Name="AuthStatus" Text="Hermes 설치 또는 기존 설치 확인 뒤 로그인 상태를 확인합니다." Margin="0,12,0,8" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
          <TextBox x:Name="AuthCode" IsReadOnly="True" FontSize="20" AutomationProperties.Name="일회용 인증 코드"/>
          <TextBlock Text="공통 기본 모델" Margin="0,12,0,6"/>
          <ComboBox x:Name="ModelCombo" IsEnabled="False" MinHeight="32" AutomationProperties.Name="연구 에이전트 기본 모델"/>
          <Button x:Name="HermesNextButton" Content="다음: 에이전트 4개" HorizontalAlignment="Right" Margin="0,16,0,0" IsEnabled="False"/>
        </StackPanel></ScrollViewer>
      </TabItem>
      <TabItem x:Name="TeamTab" Header="3. 에이전트 4개" IsEnabled="False">
        <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="20">
          <TextBlock Text="네 에이전트의 이름·봇 토큰·역할을 한 화면에서 설정합니다." FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"/>
          <Grid Margin="0,12,0,12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <StackPanel><TextBlock Text="로컬 Mattermost 주소"/><TextBox x:Name="TeamServerURL" Text="http://127.0.0.1:18065" IsReadOnly="True" Margin="0,5,0,0"/></StackPanel>
            <StackPanel Grid.Column="2"><TextBlock Text="연구 채널 ID"/><TextBox x:Name="HomeChannelID" IsReadOnly="True" Margin="0,5,0,0"/></StackPanel>
          </Grid>
          <TextBlock Text="토큰은 직접 입력하거나 행의 ‘봇 발급’을 누르세요. 발급 시 아래에 이 연구실의 관리자 비밀번호를 입력합니다." TextWrapping="Wrap" Margin="0,0,0,10"/>
          <DockPanel Margin="0,0,0,12"><TextBlock Text="봇 발급용 관리자 비밀번호" VerticalAlignment="Center" Margin="0,0,12,0"/><PasswordBox x:Name="TeamAdminPassword" Width="260" HorizontalAlignment="Left" AutomationProperties.Name="봇 발급용 관리자 비밀번호"/></DockPanel>
          <Grid x:Name="AgentRows" AutomationProperties.Name="연구 에이전트 네 개 설정"/>
          <Expander Header="역할 이름·상세 지침 편집 — 나중에도 수정 가능" Margin="0,14,0,10">
            <StackPanel Margin="0,10,0,0">
              <ComboBox x:Name="RoleEditorCombo" MinHeight="32" AutomationProperties.Name="편집할 역할"/>
              <TextBlock Text="역할 이름" Margin="0,8,0,4"/><TextBox x:Name="RoleName"/>
              <TextBlock Text="상세 역할 지침" Margin="0,8,0,4"/>
              <TextBox x:Name="RoleInstructions" Height="85" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
              <Button x:Name="RoleSaveButton" Content="역할 템플릿 저장" HorizontalAlignment="Left" Margin="0,8,0,0"/>
            </StackPanel>
          </Expander>
          <CheckBox x:Name="TeamResumeCheck" Content="이 마법사에서 만든 연구 프로필을 재설정 (이름·역할·토큰 변경, 메모리·세션 유지)" Margin="0,6,0,10"/>
          <CheckBox x:Name="TeamConsent" Content="네 프로필을 구성하고 로그인 시 자동 실행되는 Gateway 작업을 등록하는 데 동의합니다." Margin="0,0,0,12"/>
          <WrapPanel><Button x:Name="TeamApplyButton" Content="연구팀 생성·연결" IsEnabled="False"/><Button x:Name="TeamOpenButton" Content="연구 채널 열기" IsEnabled="False"/></WrapPanel>
          <TextBox x:Name="TeamResult" Height="95" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,12,0,0" AutomationProperties.Name="연구팀 구성 결과"/>
          <TextBlock Text="구성 완료 후 Mattermost에서 각 봇을 @멘션해 실제 답변을 확인하세요. 역할은 행동 지침이며, 네 봇의 자동 토론 기능은 후속 단계에서 추가할 수 있습니다." TextWrapping="Wrap" Margin="0,8,0,0" Foreground="#56657D"/>
        </StackPanel></ScrollViewer>
      </TabItem>
    </TabControl>
    <StackPanel Grid.Row="2" Margin="0,12,0,0">
      <ProgressBar x:Name="Progress" Height="8" Minimum="0" Maximum="100" AutomationProperties.Name="설치 진행률"/>
      <TextBox x:Name="Log" Height="82" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,8,0,0" AutomationProperties.Name="설치 진행 안내"/>
    </StackPanel>
    <DockPanel Grid.Row="3" Margin="0,12,0,0"><Button x:Name="CloseButton" Content="닫기" DockPanel.Dock="Right" HorizontalAlignment="Right"/><TextBlock Text="로컬 초기 버전 · Docker Desktop 실행 필요" VerticalAlignment="Center" Foreground="#56657D"/></DockPanel>
  </Grid>
</Window>
